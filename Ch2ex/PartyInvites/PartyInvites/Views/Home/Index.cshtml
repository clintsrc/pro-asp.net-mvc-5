<!--
    2.4
    The Razor view engine interprets the at- expressions. It processes the contents of the View and generates the HTML 
    to send to the browser. The simple Razor expression here indicates that no layout (HTML template) is used
//-->
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <div>
        @ViewBag.Greeting World (from the view)
        <!-- 2.8 Display a placeholder for details of a party //-->
        <p>
            We're going to have an exciting party.<br />
            (To do: sell it better. Add pictures or something.)
        </p>

        <!-- 2.10
                Add a link to the RSVP Form

                Html.ActionLink is an HTML helper method:
                Param1: the link text
                Param2: action when the link is clicked

                This example "RSVP" link points to a form (Action) that doesn't exist yet: http://host/Home/RsvpForm
                Each action method has its own URL, and MVC uses the ASP.NET routing system to translate these URLs into actions.

                Other built-in helper methods provide text inputs, checkboxes, selections, etc.
            //-->
        @Html.ActionLink("RSVP", "RsvpForm")
    </div>
</body>
</html>
