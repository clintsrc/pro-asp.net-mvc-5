@model PartyInvites.Models.GuestResponse

@{
    Layout = null;
}

<!DOCTYPE html>
<!--
    2.22
    Styling with bootstrap

    NOTE: the book uses Bootstrap 3 and bootstrap-theme.css, but in later versions the themes were all moved into the main bootstrap.css file
    The VS2022 MVC template already includes bootstrap 4 by default.

    2.23 see Views/Home/Thanks.cshtml
//-->
<html>
<head>
    <link href="~/Content/bootstrap.css" rel="stylesheet" /> <!-- import bootstrap //-->
    <meta name="viewport" content="width=device-width" />
    <title>RsvpForm</title>
    <link href="~/Content/Styles.css" rel="stylesheet" />

</head>
<body>
    <div class="card border-success">   <!-- NOTE: bootstrap v4+ uses cards (instead of panels) //-->
        <div class="card-header text-center bg-success text-white">
            <h4>RSVP</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.ValidationSummary()
                <div class="form-group">
                    <label>Your name:</label>
                    @Html.TextBoxFor(x => x.Name, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>Your email:</label>
                    @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>Your phone:</label>
                    @Html.TextBoxFor(x => x.Phone, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>Will you attend?</label>
                    @Html.DropDownListFor(x => x.WillAttend, new[] {
                        new SelectListItem() {Text = "Yes, I'll be there",
                            Value = bool.TrueString},
                        new SelectListItem() {Text = "No, I can't come",
                            Value = bool.FalseString}
                    }, "Choose an option", new { @class = "form-control" })
                </div>

                <div class="text-center">
                    <input class="btn btn-success" type="submit" value="Submit RSVP" />
                </div>
            }
        </div>
    </div>
</body>
</html>