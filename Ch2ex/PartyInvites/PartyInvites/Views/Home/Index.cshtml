<!--
    2.4
    The Razor view engine interprets the at- expressions. It processes the contents of the View and generates the HTML 
    to send to the browser. The simple Razor expression here indicates that no layout (HTML template) is used
//-->
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <div>
        <!-- 2.5 Add some text here to display on the page -->
        <!-- Hello World (from the view) //-->

        <!-- 2.7 Using the ViewBag object //-->
        @ViewBag.Greeting World (from the view)
    </div>
</body>
</html>
